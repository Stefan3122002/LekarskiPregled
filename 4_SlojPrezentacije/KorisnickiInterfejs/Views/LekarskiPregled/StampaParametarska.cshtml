@model KorisnickiInterfejs.Models.StampaLekarskiPregledViewModel
@{
    ViewBag.Title = "Parametarska stampa pregleda";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Parametarska stampa lekarskih pregleda</h2>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Nazad</a>
</div>

@using (Html.BeginForm("StampaParametarska", "LekarskiPregled", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.DatumOd, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.DatumOd, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.DatumDo, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.DatumDo, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ProfilID, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.ProfilID, Model.ProfiliSeznam, new { @class = "form-select" })
                    </div>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary mb-3 w-100">Prikazi izvjestaj</button>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.Rezultati != null)
{
    <h4>Rezultati (@Model.Rezultati.Rows.Count zapisa)</h4>
    if (Model.Rezultati.Rows.Count == 0)
    {
        <div class="alert alert-info">Nema pregleda za odabrane kriterije.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-sm">
                <thead class="table-primary">
                    <tr>
                        @foreach (System.Data.DataColumn col in Model.Rezultati.Columns)
                        {
                            <th>@col.ColumnName</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (System.Data.DataRow row in Model.Rezultati.Rows)
                    {
                        <tr>
                            @foreach (var item in row.ItemArray)
                            {
                                <td>@item</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <button onclick="window.print()" class="btn btn-primary">&#128438; Stampaj</button>
    }
}
