<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Lekarski pregled za upis</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .navbar-brand { font-weight: bold; letter-spacing: 1px; }
        .nivo-5 { background-color: #dc3545; color: white; }
        .nivo-4 { background-color: #fd7e14; color: white; }
        .nivo-3 { background-color: #ffc107; color: black; }
        .nivo-2 { background-color: #198754; color: white; }
        .nivo-1 { background-color: #6c757d; color: white; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index","LekarskiPregled")">
                &#127973; Lekarski pregled za upis
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    @if (Session["KorisnikID"] != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index","LekarskiPregled")">Lekarski pregledi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index","Kandidat")">Kandidati</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index","PrilozeniNalaz")">Prilozeni nalazi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Unos","LekarskiPregled")">Novi pregled</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (Session["KorisnikID"] != null)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-light">@Session["ImePrezime"]</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Odjava","Login")">Odjava</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        @if (TempData["Poruka"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Poruka"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>

    <footer class="bg-light text-center text-muted py-3 mt-5">
        <small>Evidencija lekarskih pregleda za upis u srednju skolu &copy; @DateTime.Now.Year</small>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
