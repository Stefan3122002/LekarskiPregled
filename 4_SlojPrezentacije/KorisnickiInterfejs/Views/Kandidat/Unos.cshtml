@model KorisnickiInterfejs.Models.KandidatViewModel
@{
    ViewBag.Title = "Dodavanje kandidata";
}

<h2>Dodavanje kandidata</h2>
<hr />

@using (Html.BeginForm("Unos", "Kandidat", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

    <div class="row">
        <div class="col-md-4">
            <div class="mb-3">
                @Html.LabelFor(m => m.Ime, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.Ime, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Ime, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-4">
            <div class="mb-3">
                @Html.LabelFor(m => m.Prezime, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.Prezime, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Prezime, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-4">
            <div class="mb-3">
                @Html.LabelFor(m => m.JMBG, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.JMBG, new { @class = "form-control", maxlength = "13", placeholder = "13 cifara" })
                @Html.ValidationMessageFor(m => m.JMBG, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3">
            <div class="mb-3">
                @Html.LabelFor(m => m.DatumRodjenja, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.DatumRodjenja, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.DatumRodjenja, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                @Html.LabelFor(m => m.VrstaUpisa, new { @class = "form-label fw-bold" })
                @Html.DropDownListFor(m => m.VrstaUpisa, Model.VrsteUpisaSeznam, new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.VrstaUpisa, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                @Html.LabelFor(m => m.SkolaID, new { @class = "form-label fw-bold" })
                @Html.DropDownListFor(m => m.SkolaID, Model.SkoleSeznam, "-- Odaberite skolu --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.SkolaID, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                @Html.LabelFor(m => m.ProfilID, new { @class = "form-label fw-bold" })
                @Html.DropDownListFor(m => m.ProfilID, Model.ProfiliSeznam, "-- Obrazovni profil --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.ProfilID, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="mb-3 form-check">
        @Html.CheckBoxFor(m => m.Aktivan, new { @class = "form-check-input" })
        @Html.LabelFor(m => m.Aktivan, new { @class = "form-check-label" })
    </div>

    <button type="submit" class="btn btn-primary">Sacuvaj</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary ms-2">Odustani</a>
}
