@model IEnumerable<KlasePodataka.Entiteti.PrilozeniNalazKlasa>
@{
    ViewBag.Title = "Prilozeni nalazi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Prilozeni nalazi dodatnih specijalistickih pregleda</h2>
    <a href="@Url.Action("Unos")" class="btn btn-primary">+ Novi nalaz</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered">
        <thead class="table-primary">
            <tr>
                <th>ID</th>
                <th>Pregled</th>
                <th>Kandidat</th>
                <th>Vrsta nalaza</th>
                <th>Datum nalaza</th>
                <th>Ustanova</th>
                <th>Uredan</th>
                <th>Napomena</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="9" class="text-center text-muted">Nema unesenih nalaza.</td></tr>
            }
            @foreach (var n in Model)
            {
                <tr>
                    <td>@n.NalazID</td>
                    <td>#@n.PregledID</td>
                    <td>@(n.Pregled?.Kandidat?.ImePrezime ?? "-")</td>
                    <td><strong>@n.VrstaNalaza</strong></td>
                    <td>@n.DatumNalaza.ToString("dd.MM.yyyy")</td>
                    <td>@n.Ustanova</td>
                    <td>
                        @if (n.Uredan)
                        {
                            <span class="badge bg-success">DA</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">NE</span>
                        }
                    </td>
                    <td>@(n.Napomena ?? "-")</td>
                    <td>
                        <a href="@Url.Action("Izmena", new { id = n.NalazID })"
                           class="btn btn-warning btn-sm">Izmijeni</a>
                        @using (Html.BeginForm("Brisanje", "PrilozeniNalaz", new { id = n.NalazID }, FormMethod.Post, new { style = "display:inline" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Da li ste sigurni da zelite obrisati ovaj nalaz?')">
                                Obrisi
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
