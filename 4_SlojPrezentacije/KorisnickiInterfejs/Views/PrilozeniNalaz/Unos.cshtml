@model KorisnickiInterfejs.Models.PrilozeniNalazViewModel
@{
    ViewBag.Title = "Novi prilozeni nalaz";
}

<h2>Novi prilozeni nalaz</h2>
<hr />

@using (Html.BeginForm("Unos", "PrilozeniNalaz", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                @Html.LabelFor(m => m.PregledID, new { @class = "form-label fw-bold" })
                @Html.DropDownListFor(m => m.PregledID, Model.PregledSeznam, "-- Odaberite pregled --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.PregledID, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                @Html.LabelFor(m => m.VrstaNalaza, new { @class = "form-label fw-bold" })
                @Html.DropDownListFor(m => m.VrstaNalaza, Model.VrsteNalazaSeznam, new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.VrstaNalaza, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="mb-3">
                @Html.LabelFor(m => m.DatumNalaza, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.DatumNalaza, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.DatumNalaza, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-5">
            <div class="mb-3">
                @Html.LabelFor(m => m.Ustanova, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.Ustanova, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Ustanova, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3 mt-4 form-check">
                @Html.CheckBoxFor(m => m.Uredan, new { @class = "form-check-input" })
                @Html.LabelFor(m => m.Uredan, new { @class = "form-check-label" })
            </div>
        </div>
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Napomena, new { @class = "form-label" })
        @Html.TextAreaFor(m => m.Napomena, new { @class = "form-control", rows = "2",
            placeholder = "Napomena je obavezna ako nalaz nije uredan." })
        @Html.ValidationMessageFor(m => m.Napomena, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">Sacuvaj nalaz</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary ms-2">Odustani</a>
}
